{
  "manifest_version": 3,
  "name": "Aqua Super WhatsApp Tab Reuser",
  "version": "1.1.0",
  "description": "Experimental SPA navigation for Aqua Super customer messages in an existing WhatsApp Web tab.",
  "permissions": [
    "tabs",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aqua-super.github.io/Aqua-Super/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
